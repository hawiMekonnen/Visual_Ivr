# Database
DATABASE_URL=sqlite:///./dev.db

# Security & JWT
SECRET_KEY=local-dev-secret-key-32-chars-long-minimum-requirement
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Media / Audio
MEDIA_DIR=./media
MEDIA_URL_PREFIX=/media

# Telephony / Agent Connector
AGENT_CONNECTOR=dev
DEFAULT_AGENT_EXTENSION=1002

# Application Settings
DEBUG=True
DEFAULT_LOCALE=en
APP_NAME="Visual IVR"

# Google Gemini AI Translation & Voice Assistant
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Frontend base URL for SMS links
FRONTEND_BASE_URL=https://192.168.1.6:5173

# SMS Gateway Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

ANDROID_GATEWAY_URL=http://192.168.1.4:8082
ANDROID_GATEWAY_TOKEN=
TEST_DESTINATION_PHONE=

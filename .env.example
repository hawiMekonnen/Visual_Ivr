# --- DATABASE ---
# For docker-compose (default):
DATABASE_URL=postgresql://ivruser:ivrpassword123@postgres:5432/visualivr
# For local sqlite dev:
# DATABASE_URL=sqlite:///./dev.db

# --- SECURITY ---
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- MEDIA STORAGE ---
MEDIA_DIR=./media
MEDIA_URL_PREFIX=/media

# --- AGENT TELEPHONY ---
AGENT_CONNECTOR=dev
DEFAULT_AGENT_EXTENSION=8000

# Twilio (Optional future swap)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- GENERAL APP SETTINGS ---
DEBUG=False
DEFAULT_LOCALE=en
VITE_API_URL=http://localhost:8000
